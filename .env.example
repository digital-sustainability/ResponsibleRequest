# Copy to .env and fill in. Never commit .env.
# Read by the OpenAI SDK (and therefore by responsible_request) from the environment.
# Load it with: uv run --env-file .env python examples/quickstart.py
OPENAI_BASE_URL=
OPENAI_API_KEY=
# For OpenRouter, e.g. OPENAI_BASE_URL=https://openrouter.ai/api/v1 (examples/openrouter.py reads:)
OPENROUTER_API_KEY=
